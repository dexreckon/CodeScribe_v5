# --- AI (Gemini free tier, rotating keys). Put your real keys in a file named .env (never commit it) ---
AI_API_KEYS=PASTE_KEY_1,PASTE_KEY_2,PASTE_KEY_3
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
# per-key requests/minute pacing (free tier is ~10-15 RPM) and max seconds to wait for a free key
AI_RPM=10
AI_MAX_WAIT=20
AI_ENHANCE_LIMIT=25
MAX_UPLOAD_MB=20
# --- On Vercel: set these in Project Settings > Environment Variables (not in a file). Use MAX_UPLOAD_MB=4 (Vercel request limit is ~4.5 MB) ---
